# Dependencies
/node_modules

# Coverage
/coverage

# Bundle analysis
/stats

# Environment
.env
.env.backup
.env.production
.env.local
env.json

# Logs
npm-debug.log
yarn-error.log
*.log

# IDE
/.idea
/.vscode
/.zed
/.claude
/.junie
.phpactor.json

# OS
.DS_Store
Thumbs.db

# Package manager locks (use package-lock.json)
yarn.lock
pnpm-lock.yaml

# App config (fork workflow — actual configs are local-only)
# Template and README in configs/ are tracked; actual definitions are not
configs/*.yaml
configs/*.yml
configs/*.ts
configs/*.js
configs/*.json

# Runtime output
/output

# Compound Engineering — shipped prose is re-seeded per clone by
# /sixees-workflow:init-compound; only the project profile is tracked.
docs/compound/*
!docs/compound/compound-engineering-profile.md

# Compound Engineering workflow — per-clone, never committed.
# A committed review roster is a recon vector: an attacker-influenced roster on a
# fork or collaborator branch is checked out into the review worktree and read as
# configuration.
/sixees-workflow.local.md
/compound-workflow.local.md
/docs/work/.scratch/
